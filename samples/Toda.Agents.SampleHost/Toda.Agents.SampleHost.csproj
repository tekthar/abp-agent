<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>A host of toda-agents alone (ADR 0091, A6): a help desk's tickets in its own table, worked on by agents with the package's own run queue and a scripted model. What another product (the marketplace) does to use agents, and what Toda.Agents.Host.Tests proves.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Toda.Agents\Toda.Agents.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
  </ItemGroup>

</Project>
