<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>A host of AbpAgent alone: a help desk's tickets in its own table, worked on by agents with the package's own run queue and a scripted model. What any product does to use agents, and what AbpAgent.Host.Tests proves.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AbpAgent\AbpAgent.csproj" />
    <ProjectReference Include="..\..\src\AbpAgent.Graphiti\AbpAgent.Graphiti.csproj" />
    <ProjectReference Include="..\..\src\AbpAgent.HttpApi\AbpAgent.HttpApi.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
  </ItemGroup>

</Project>
