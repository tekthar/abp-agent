<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AbpAgent.HttpApi: AbpAgent's services over HTTP, the same agents' API for every host: agents, runs on items with their steps, questions, chats with live events, memories and the graph, standing permissions and the tools an agent may be given. The host sets the route prefix and says who is calling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbpAgent\AbpAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
  </ItemGroup>

</Project>
